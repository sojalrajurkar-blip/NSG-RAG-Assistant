# =====================================================================
# NSG Academy Knowledge Assistant - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and fill in your actual private credentials.
# DO NOT commit '.env' to version control or share it publicly.

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model name (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL_NAME=gemini-2.5-flash

# Vector DB & Embeddings Configuration
CHROMA_PERSIST_DIRECTORY=chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chunking Configuration
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=80

# Retrieval Configuration
DEFAULT_TOP_K=3
